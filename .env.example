# Opcional: copiar a .env solo para cambiar algún valor; docker-compose.yml ya tiene estos por defecto.
# Si cambian el puerto o las credenciales de Postgres, exporten también en su terminal las variables que
# leen la web (INSTITUCION_DB_URL/USER/PASSWORD) y app-materiales (FLOWABLE_DB_URL/USER/PASSWORD).
POSTGRES_USER=flowable
POSTGRES_PASSWORD=flowable
POSTGRES_PORT=5432
FLOWABLE_PORT=8080
# Aulas del web service de aulas simulado. 10 no se agotan en el uso normal; el escenario 7 (falta de aulas) pide 3
# (docs/12). Cambiarlo exige recrear Flowable: docker compose up -d flowable.
AULAS_DISPONIBLES=10
