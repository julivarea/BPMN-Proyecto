<?xml version="1.0" encoding="UTF-8"?>
<!-- Motor en memoria (H2) para los tests del proceso; no usa Docker ni la BD compartida. -->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

  <bean id="processEngineConfiguration" class="org.flowable.engine.impl.cfg.StandaloneInMemProcessEngineConfiguration">
    <property name="jdbcUrl" value="jdbc:h2:mem:flowable;DB_CLOSE_DELAY=-1"/>
    <property name="asyncExecutorActivate" value="false"/>
    <property name="configurators">
      <list>
        <bean class="org.flowable.dmn.engine.configurator.DmnEngineConfigurator"/>
      </list>
    </property>
  </bean>
</beans>
