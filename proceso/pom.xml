<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ar.edu.unrc.gtpn</groupId>
        <artifactId>organizacion-cursos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>proceso</artifactId>
    <name>Proceso: modelo BPMN, regla DMN y extensiones del motor</name>

    <properties>
        <!-- El jar corre dentro de la imagen flowable-ui:6.8.0, que trae Java 11. -->
        <maven.compiler.release>11</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- "provided": el servidor Flowable ya trae el motor; el jar solo aporta nuestras clases. -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-engine</artifactId>
            <version>${flowable.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- BCrypt de las claves de las empresas. "provided": la imagen de Flowable ya trae
             spring-security-crypto 5.8.1 en /app/WEB-INF/lib; no hay que empaquetarlo. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <version>5.8.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-dmn-engine-configurator</artifactId>
            <version>${flowable.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.1.214</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Nombre fijo: docker-compose.yml monta target/proceso.jar dentro del servidor Flowable. -->
        <finalName>proceso</finalName>
    </build>
</project>
